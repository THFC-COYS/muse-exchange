# Postgres connection string. Required for publish, reviews, and follows.
# Without it the app runs on built-in seed data and write features show a setup notice.
#
# Vercel Postgres: create a database in the Vercel dashboard (Storage tab),
# then pull the env vars with `vercel env pull` or copy them into the
# project settings. The pooled URL works best on serverless.
#   DATABASE_URL="postgres://user:password@host:5432/db?pgbouncer=true&connect_timeout=15"
#
# Neon: create a project at neon.tech, copy the pooled connection string.
#   DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/db?sslmode=require"
#
# Local Postgres:
#   DATABASE_URL="postgresql://user:password@localhost:5432/muse_exchange"

DATABASE_URL="postgresql://user:password@localhost:5432/muse_exchange"
